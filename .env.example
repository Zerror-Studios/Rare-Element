# Rare Element storefront — environment variables (names only; never commit
# values). NEXT_PUBLIC_* values are inlined into the browser bundle.

# ─── API (PRD-001 phase 2: same-origin API) ────────────────────────────────
# Gateway origin, server-only. Required in production. The browser calls
# /v1/graphql on this site and src/middleware.js proxies it to
# ${API_GATEWAY_URL}/v1/graphql; server components call it directly.
API_GATEWAY_URL=
# Server-only, optional (PRD-002 R2-C1): the gateway's EDGE_SHARED_SECRET.
# Sent as x-zcom-edge-secret on proxied and server-side calls so strict
# tenant mode trusts x-tenant-domain and x-zcom-client-ip. Never prefix it
# with NEXT_PUBLIC_.
EDGE_SHARED_SECRET=
# Browser GraphQL endpoint. Leave unset to use the same-origin default
# /v1/graphql (needed for the HttpOnly customer session cookie).
NEXT_PUBLIC_GRAPHQL_API_URL=

# ─── Tenant and site ───────────────────────────────────────────────────────
# Brand domain that selects the tenant (e.g. nahara.co.in). Required in
# production; sent as x-tenant-domain / x-forwarded-host server-side.
NEXT_PUBLIC_TENANT_DOMAIN=
# Canonical site origin for metadata, canonical URLs and JSON-LD
# (defaults to https://<NEXT_PUBLIC_TENANT_DOMAIN>; with neither set every
# page is noindex and robots.txt disallows all, W2V-C-04).
NEXT_PUBLIC_SITE_URL=
# Support address shown on the checkout result pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ─── Analytics (no defaults: an unset id loads no tag; PRD-014 FR-1.9) ───
# Tags load only after the shopper's cookie consent (utils/consent.js).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# ─── Security headers ──────────────────────────────────────────────────────
# "true" sends the CSP as Content-Security-Policy-Report-Only (rollout).
CSP_REPORT_ONLY=
